# API
PORT=8080
RUST_LOG=futurefin_api=info,tower_http=info

# PostgreSQL (Compose uses these defaults; override for prod)
DATABASE_URL=postgres://futurefin:futurefin@127.0.0.1:5432/futurefin

# Sessions / browser cookies (set COOKIE_SECURE=1 behind HTTPS)
SESSION_TTL_DAYS=30
COOKIE_SECURE=0

# Comma-separated origins allowed to send credentials (cookies) from the browser
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

# Optional: directory with `index.html` + Vite `dist/` assets (Docker sets /app/web). Omit for API-only local runs.
# WEB_STATIC_ROOT=
