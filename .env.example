# API
# Split dev (Vite → WEB_DEV_PORT, usualmente 8080): usa PORT=8081 para que API y frontend no choquen.
# Compose / imagen Docker: dentro del contenedor sigue siendo PORT=8080 (host también publica :8080).
PORT=8081
RUST_LOG=futurefin_api=info,tower_http=info

# Puerto donde corre la API para el proxy de Vite (debe coincidir con PORT salvo configuraciones raras).
# FUTUREFIN_API_PORT=8081

# Puerto del servidor de desarrollo Vite (interfaz con hot reload).
# WEB_DEV_PORT=8080

# PostgreSQL (Compose uses these defaults; override for prod)
DATABASE_URL=postgres://futurefin:futurefin@127.0.0.1:5432/futurefin

# Sessions / browser cookies (set COOKIE_SECURE=1 behind HTTPS)
SESSION_TTL_DAYS=30
COOKIE_SECURE=0

# Orígenes del navegador que pueden enviar cookies. Incluye :5173 por si Vite cae ahí al estar :8080 ocupado.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

# Optional: directory with `index.html` + Vite `dist/` assets (Docker sets /app/web). Omit for API-only local runs.
# WEB_STATIC_ROOT=
