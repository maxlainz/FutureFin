# Copia esto como `.env.prod` en el NAS y ajusta valores sensibles.

# --- GHCR (imagen de la app) ---
# Ejemplo: ghcr.io/miusuario/futurefin
FUTUREFIN_IMAGE=ghcr.io/<TU_GITHUB_USERNAME>/futurefin

# Tag a desplegar en producción (recomendado: latest o vX.Y.Z)
FUTUREFIN_TAG=latest

# --- Dominio (para Caddy/TLS y CORS) ---
FUTUREFIN_DOMAIN=your-domain.example
#
# Email usado por Caddy para ACME (Let's Encrypt).
CADDY_EMAIL=you@your-domain.example

# --- Sesiones / CORS ---
COOKIE_SECURE=1
SESSION_TTL_DAYS=30
# Importante: pon aquí el/los orígenes exactos (por ejemplo `https://your-domain.example`).
# No dependas de interpolación dentro de este fichero.
CORS_ORIGINS=https://your-domain.example

# --- PostgreSQL ---
POSTGRES_USER=futurefin
POSTGRES_DB=futurefin
# Cambia esto por una contraseña fuerte.
POSTGRES_PASSWORD=change_me_strong_password

